{
  "name": "villa-palm",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "plans": "tsx scripts/export-plan-data.ts && python3 scripts/make-plans.py",
    "assets": "python3 scripts/fetch-assets.py",
    "sun": "tsx scripts/sun-from-hdri.ts",
    "images": "python3 scripts/make-web-images.py",
    "zip": "npm run build && cd dist && rm -f ../villa-palm-dist.zip && zip -qr ../villa-palm-dist.zip . && echo \"-> villa-palm-dist.zip\""
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/noto-sans-arabic": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.1.3",
    "gsap": "^3.15.0",
    "postprocessing": "^6.39.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "styled-components": "^6.5.3",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/styled-components": "^5.1.36",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}